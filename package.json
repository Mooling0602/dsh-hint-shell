{
  "name": "dsh-hint-shell",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "description": "Makes ! a shell prefix in the DeepSeek Harness composer: runs the command in the session's working directory and records its output as a tool result, with a configurable command length cap.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cordis",
    "composer",
    "hint",
    "shell"
  ],
  "license": "MIT",
  "icon": "icon.svg",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.test.ts && node test/host.test.ts && node test/dsh-format.test.ts",
    "prepare": "node build.mjs",
    "prepublishOnly": "node build.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-client-store": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "author": "Mooling0602",
  "homepage": "https://github.com/Mooling0602/dsh-hint-shell",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mooling0602/dsh-hint-shell.git"
  },
  "bugs": {
    "url": "https://github.com/Mooling0602/dsh-hint-shell/issues"
  }
}
